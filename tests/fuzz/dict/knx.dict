# libFuzzer dictionary for the CoAP/CBOR harnesses: KNX IoT URIs, query keys and CBOR tokens.

# URI path segments (Uri-Path options carry them without '/')
p_wk=".well-known"
p_core="core"
p_knx="knx"
p_spake="spake"
p_ia="ia"
p_f="f"
p_dev="dev"
p_sn="sn"
p_hname="hname"
p_iid="iid"
p_pm="pm"
p_ipv6="ipv6"
p_sna="sna"
p_da="da"
p_fid="fid"
p_port="port"
p_mport="mport"
p_mid="mid"
p_ap="ap"
p_pv="pv"
p_a="a"
p_lsm="lsm"
p_k="k"
p_p="p"
p_fp="fp"
p_g="g"
p_r="r"
p_auth="auth"
p_at="at"
p_o="o"
p_osndelay="osndelay"
p_replwdo="replwdo"
p_sub="sub"
p_swu="swu"
p_pkgv="pkgv"
p_update="update"
p_protocol="protocol"
p_method="method"
p_lastupdate="lastupdate"
p_result="result"
p_state="state"
p_pkgbytes="pkgbytes"
p_pkgname="pkgname"

# full paths, as stored hrefs and as resource lookups
h_p1="/p/1"
h_fp_g="/fp/g"
h_auth_at="/auth/at"
h_wk_core="/.well-known/core"

# Uri-Query keys and values
q_ep="ep="
q_ep_sn="ep=knx://sn."
q_ep_ia="ep=knx://ia."
q_rt="rt="
q_if="if="
q_lt="lt="
q_l="l="
q_pn="pn="
q_ps="ps="
q_po="po="
q_pkgs="pkgs="
q_non="non=true"
q_amp="&"
q_star="*"
v_dpa="urn:knx:dpa."
v_dpt=":dpt."
v_if="urn:knx:if."
v_if_sec="if.sec"
v_if_i="if.i"
v_if_o="if.o"
v_if_ll="if.ll"
v_if_pm="if.pm"
v_if_c="if.c"
v_if_b="if.b"
v_if_a="if.a"
v_if_s="if.s"

# s-mode service type w (r and a are above), LSM / device events
st_w="w"
e_restart="restart"
e_reset="reset"
e_non="non"
e_osv="osv:true"

# CBOR: map/array heads, simple values, wider ints, KNX keys > 23
c_map1="\xa1"
c_map4="\xa4"
c_arr1="\x81"
c_arr_indef="\x9f"
c_break="\xff"
c_false="\xf4"
c_true="\xf5"
c_null="\xf6"
c_u8="\x18"
c_u16="\x19"
c_u32="\x1a"
c_u64="\x1b"
c_neg32="\x3a\x7f\xff\xff\xff"
c_double="\xfb"
c_tstr_indef="\x7f"
c_bstr16="\x50"
c_key_profile="\x18\x26"
c_key_iid="\x18\x1a"
c_key_fid="\x18\x19"
c_key_osc_id="\x19\x03\x48"
c_key_osc_ms="\x19\x03\x4a"
c_key_osc_salt="\x19\x03\x4d"
c_key_osc_ctx="\x19\x03\x4e"
c_key_ga_at="\x19\x03\x09"

# CoAP option values: Content-Format / Accept CBOR, Observe, Block
o_cbor="\x3c"
o_observe_reg="\x00"
o_observe_dereg="\x01"

# OSCORE inner option headers after the inner code: Uri-Path (delta 11, 3 bytes),
# then Content-Format CBOR and Accept CBOR
io_uri_path="\xb3"
io_cf_cbor="\x11\x3c"
io_accept_cbor="\x51\x3c"
