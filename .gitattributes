# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.c text
*.h text
*.java text

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.vcxproj.user text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Declare files that will always have LF line endings on checkout.
*.pem text eol=lf
# Shell scripts run inside Linux containers (tests/common/tools/*.sh are
# shipped into the CI image by tar); a CRLF checkout on Windows would break
# them with "$'': command not found".
*.sh text eol=lf
# Zephyr patches are applied with git am inside Linux containers (the demos'
# Docker image); a CRLF checkout would put a stray carriage return into every
# patched line.
*.patch text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
