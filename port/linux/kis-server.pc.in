prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: knx-iot-stack-server
Description: KNX IOT Stack server library
Version: @version@
Libs.private: -lm -pthread
Cflags: -I${includedir}/kis -DOC_SERVER @extra_cflags@
Libs: -L${libdir} -lkis-server
