# Patterns see https://git-scm.com/docs/gitignore#_pattern_format

# GitHub files
.github/

# Dependend subprojects are not tracked (managed by .gitmodules)
deps/**
!deps/CMakeLists.txt

# CMake
CMakeUserPresets.json

# Claude Code: agents and skills are shared; personal settings stay local
.claude/settings.local.json
CLAUDE.local.md

# VS Code setting files
.vscode/

# VS setting files
.vs/

# Vim
.*.swp
.*.swo

# Python
__pycache__/

# various
*.o
*.cmd
*.tmp
*.gcda
*.gcno

# Build system files
build/
install/

# Integration test runtime storage
integration_test_storage_*/
runtime_test_storage_*/

# Unit-test persistent storage
knx_storage_unit_test/
knx_storage_fp_unit_test/

# DUT runtime data (persistent storage created by eitt_virtual)
knx_iot_virtual_eitt_*/

# Test output logs
test_*.log
test_*.txt

# Generated temp scripts
tests/common/tools/.docker-run.sh

# EITT reference traces (large, not tracked)
EITT_REFERENCE_PROJECT/
/Folder.DotSettings.user

# local reviews
/reviews

# Run records and other local test output (tests/iot-test-tool/docs/run-record-and-evaluator.md)
/artifacts/
