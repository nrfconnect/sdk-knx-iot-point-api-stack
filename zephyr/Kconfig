# This file is sourced by the Zephyr build system via zephyr/module.yml and
# exposes all KNX-IoT stack options in the Zephyr menuconfig / guiconfig.
# The symbol names mirror the CMake cache variables used for Linux/Windows builds.

config KNXIOT_LIB
    bool "KNX-IoT Point API Stack"
    # Since Zephyr v4.5.0 MBEDTLS and the PSA_WANT_* symbols depend on PSA_CRYPTO.
    select PSA_CRYPTO
    select MBEDTLS
    # PSA crypto requirements for KNX-IoT security (SPAKE2+ and OSCORE).
    # These selects mirror security/knx_psa_crypto_config.h (the Linux/Windows PSA
    # configuration) and bypass MBEDTLS_PROMPTLESS (set by OPENTHREAD_SECURITY_DEFAULT_CONFIG
    # when OpenThread is in the build), ensuring all required algorithms are always
    # available regardless of the active network backend.
    # Applied only when using the Zephyr platform Mbed TLS (KNXIOT_MBEDTLS_BUILTIN=n).
    #
    # PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC is not listed. Zephyr 4.4.x does not expose
    # it as a Kconfig symbol (no config entry in Kconfig.psa.auto). It is a C-level PSA
    # define that Mbed TLS implicitly provides whenever any ECC key pair operation
    # (IMPORT, EXPORT or GENERATE) is selected.
    #
    # MBEDTLS_ENTROPY_C and MBEDTLS_CTR_DRBG_C are selected for the PSA legacy RNG path
    # (ENTROPY + CTR_DRBG) needed on boards without a hardware CSPRNG and for OpenThread
    # DTLS which uses the entropy and DRBG APIs directly.
    #
    # MBEDTLS_PSA_BUILTIN_GET_ENTROPY is NOT selected. It is the Linux/Windows OS entropy
    # source (getrandom/CryptGenRandom) and would cause a hard compile error on Zephyr
    # (platform_util.c asserts Unix or Windows).
    #
    # MBEDTLS_PSA_DRIVER_GET_ENTROPY is the Zephyr replacement (entropy through Zephyr 
    # hardware drivers) and is explicitly selected below to make the intent clear, 
    # even though it is also auto-enabled via Kconfig (default y, depends on 
    # MBEDTLS_ENTROPY_C, see Kconfig.mbedtls).
    select MBEDTLS_PSA_CRYPTO_C if !KNXIOT_MBEDTLS_BUILTIN
    select MBEDTLS_ENTROPY_C if !KNXIOT_MBEDTLS_BUILTIN
    select MBEDTLS_PSA_DRIVER_GET_ENTROPY if !KNXIOT_MBEDTLS_BUILTIN
    select MBEDTLS_CTR_DRBG_C if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_ALG_CCM if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_ALG_CBC_PKCS7 if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_ALG_SHA_256 if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_ALG_HMAC if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_ALG_HKDF if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_ALG_PBKDF2_HMAC if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_ALG_ECDH if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_ECC_SECP_R1_256 if !KNXIOT_MBEDTLS_BUILTIN
    # MBEDTLS_ECP_NIST_OPTIM enables the fast reduction for the NIST P-256 prime,
    # which speeds up the SPAKE2+ elliptic-curve scalar multiplications in software.
    select MBEDTLS_ECP_NIST_OPTIM if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_KEY_TYPE_AES if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_KEY_TYPE_HMAC if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_KEY_TYPE_DERIVE if !KNXIOT_MBEDTLS_BUILTIN
    select PSA_WANT_KEY_TYPE_RAW_DATA if !KNXIOT_MBEDTLS_BUILTIN
    help
      Enable the KNX-IoT Point API protocol stack.

if KNXIOT_LIB

# ── External libraries ─────────────────────────────────────────────────────────

config KNXIOT_MBEDTLS_BUILTIN
    bool "Use stack-bundled Mbed TLS"
    default n
    help
      Corresponds to CMake: CONFIG_KNXIOT_MBEDTLS_BUILTIN.
      Set to n to use the Mbed TLS module provided by Zephyr.

config KNXIOT_TINYCBOR_BUILTIN
    bool "Use stack-bundled TinyCBOR"
    default y
    help
      Corresponds to CMake: CONFIG_KNXIOT_TINYCBOR_BUILTIN.
      TinyCBOR was dropped as a Zephyr module in Zephyr 4.x (replaced by zcbor).
      Set to n only if a separate external TinyCBOR module is provided in the
      west workspace.

# ── Protocol ───────────────────────────────────────────────────────────────────

config KNXIOT_CLIENT
    bool "KNX-IoT client mode support"
    default y
    help
      Corresponds to CMake: OC_CLIENT.

config KNXIOT_SERVER
    bool "KNX-IoT server mode support"
    default y
    help
      Corresponds to CMake: OC_SERVER.

config KNXIOT_PUBLISHER_TABLE
    bool "Publisher table (Group Publisher Table) support"
    default y
    help
      Corresponds to CMake: OC_PUBLISHER_TABLE_ENABLED.
      Enables the Group Publisher Table (GPT), which allows the device to
      participate in table-managed KNX S-mode group communication and to
      receive group messages. Disable for plain senders that only transmit
      S-mode messages without table-based management.

# ── Table sizes ────────────────────────────────────────────────────────────────

config KNXIOT_GOT_MAX_ENTRIES
    int "Group Object Table (GOT) max entries"
    default 50
    help
      Corresponds to CMake: KNX_GOT_MAX_ENTRIES.
      Maximum number of entries in the Group Object Table.
      Each entry maps one group object (a data point on this device) to a
      group address and data type. Size this to the total number of group
      objects the device exposes across all channels and functions.

config KNXIOT_GPT_MAX_ENTRIES
    int "Group Publisher Table (GPT) max entries"
    default 20
    depends on KNXIOT_PUBLISHER_TABLE
    help
      Corresponds to CMake: KNX_GPT_MAX_ENTRIES.
      Maximum number of entries in the Group Publisher Table.
      Each entry defines a group object this device publishes (sends)
      S-mode messages for. Size this to the number of group objects
      the device actively sends.

config KNXIOT_GRT_MAX_ENTRIES
    int "Group Recipient Table (GRT) max entries"
    default 20
    help
      Corresponds to CMake: KNX_GRT_MAX_ENTRIES.
      Maximum number of entries in the Group Recipient Table.
      Each entry defines a group address this device subscribes to
      (receives S-mode messages from). Size this to the number of
      group objects the device listens to.

config KNXIOT_ATT_MAX_ENTRIES
    int "Access Token Table max entries"
    default 20
    help
      Corresponds to CMake: KNX_ATT_MAX_ENTRIES.
      Maximum number of entries in the Access Token (AT) table.
      Each entry holds a security token granting a management client
      access rights to this device. Size this to the maximum number
      of management clients (e.g., ETS, MaC tools) that may be
      simultaneously authorised.

config KNXIOT_PAGE_SIZE
    int "Server default page size"
    default 20
    help
      Corresponds to CMake: KNX_PAGE_SIZE.
      Number of entries returned per page in paginated CoAP responses
      to management requests (e.g., table read-out by ETS or MaC).
      Reduce if CoAP response payloads exceed the network MTU.

# ── Network ────────────────────────────────────────────────────────────────────

choice KNXIOT_NETWORK_BACKEND
    prompt "KNX-IoT network backend"
    default KNXIOT_NETWORK_BACKEND_THREAD
    help
      Selects the connectivity implementation compiled into the stack.
      The application supplies the matching Zephyr configuration for the
      selected backend.

config KNXIOT_NETWORK_BACKEND_ETHERNET
    bool "Ethernet"
    help
      Use Ethernet as the network backend.
      Compiles port/zephyr/connectivity_posix.c with the shared DNS-SD
      responder. Needs CONFIG_NET_L2_ETHERNET.

config KNXIOT_NETWORK_BACKEND_THREAD
    bool "OpenThread"
    help
      Use OpenThread (IEEE 802.15.4 Thread mesh) as the network backend.
      Compiles port/zephyr/connectivity_thread.c with the OpenThread SRP
      client. Needs CONFIG_OPENTHREAD, with or without the Zephyr
      OpenThread L2.

config KNXIOT_NETWORK_BACKEND_WIFI
    bool "Wi-Fi"
    select WIFI
    help
      Use Wi-Fi as the network backend.
      Compiles port/zephyr/connectivity_posix.c with the shared DNS-SD
      responder.

endchoice

# The Thread port subscribes the all-CoAP-nodes addresses and one address per
# GPT group id in OpenThread's external multicast pool, which Zephyr defaults
# to 2. 23 = 3 all-CoAP-nodes addresses + KNXIOT_GPT_MAX_ENTRIES (default 20);
# Kconfig can't compute it, so connectivity_thread.c warns when the pool is
# smaller than that. This default only applies because this module's Kconfig
# is parsed before OpenThread's; a value in prj.conf still wins.
configdefault OPENTHREAD_IP6_MAX_EXT_MCAST_ADDRS
    default 23 if KNXIOT_NETWORK_BACKEND_THREAD

config KNX_UNICAST_PORT
    int "IPv6 unicast port for KNX S-mode messages"
    default 0
    help
      Corresponds to CMake: KNX_UNICAST_PORT.
      IPv6 unicast port used for sending and receiving unicast CoAP messages
      and KNX S-mode messages (clause 2.6.3.1, COAP_DEFAULT_PORT).
      The chosen port is used for all unicast traffic.
      Set to 0 to let the OS assign an ephemeral port.

config KNX_MULTICAST_SCOPE
    int "IPv6 multicast scope for KNX S-mode messages"
    default 5
    help
      Corresponds to CMake: KNX_MULTICAST_SCOPE.
      This is the IPv6 multicast scope used for sending and receiving KNX
      S-mode messages. Scope 2 (link-local) is appropriate for isolated
      single-segment networks or when the router blocks site-local multicast.
      Scope 5 (site-local) is the default for routed deployments.

config KNX_READ_ON_INIT_DELAY_MS
    int "Read-on-init inter-request delay (milliseconds)"
    default 100
    help
      Corresponds to CMake: KNX_READ_ON_INIT_DELAY_MILLISECONDS.
      Delay in milliseconds between consecutive S-mode read requests sent
      during the read-on-init sequence at device startup. Group objects
      with the INIT flag set are read one at a time with this delay between
      each request to avoid flooding the network. Increase on slow or
      congested networks such as Thread.

config KNX_RESET_PROCESS_TIME_S
    int "KNX reset process time (seconds)"
    default 2
    help
      Corresponds to CMake: KNX_RESPONSE_TIME_SECONDS.
      Maximum time in seconds for the device to complete a KNX reset.
      This value is sent in the reset response to management clients
      (e.g., EITT, MaC) so they know how long to wait before issuing
      follow-up requests while the device is resetting locally.

# ── Security ───────────────────────────────────────────────────────────────────

config KNXIOT_ECHO_RING_SIZE
    int "Echo ring size"
    default 16
    help
      Corresponds to CMake: KNX_ECHO_RING_SIZE.
      Details see 'ECHO RING'.

# ── Shell ──────────────────────────────────────────────────────────────────────

config KNXIOT_SHELL
    bool "KNX IoT shell command (knx_iot)"
    default y
    depends on SHELL
    help
      Compiles the shared KNX IoT shell commands (port/knx_shell_commands.c) and their
      Zephyr shell binding (port/zephyr/knx_shell.c), which registers the "knx_iot"
      command with its subcommands (device parameters, tables, factory reset, heap
      statistics). Needs the Zephyr shell (CONFIG_SHELL).

# ── Testing ────────────────────────────────────────────────────────────────────

config KNXIOT_TEST_CONTROL
    bool "Test-control endpoints (/test/restart, /test/factory-reset, /test/trigger)"
    default n
    help
      Compiles api/oc_test_control.c and defines KNX_TEST_CONTROL for all targets.
      Registers the non-standard /test/* CoAP endpoints used by the Python runtime
      conformance suite (tests/runtime) to automate operator actions normally done
      by hand in the EITT GUI: soft restart, factory reset, and sensor trigger.
      The application must call oc_test_control_register() when this is set (the
      EITT demo app does so under #ifdef KNX_TEST_CONTROL). Off by default. The
      EITT demo enables it via CONFIG_KNXIOT_TEST_CONTROL=y in its prj.conf.
      Leave off for lssb/lsab and any production build.

# ── Timing ─────────────────────────────────────────────────────────────────────
# OC_CLOCK_CONF_TICKS_PER_SECOND (port/zephyr/oc_config.h) is set to
# CONFIG_SYS_CLOCK_TICKS_PER_SEC so the KNX-IoT timer arithmetic matches
# oc_clock_time() which returns k_uptime_get() (milliseconds).
# No separate KNX-IoT symbol is needed; configure the tick rate via
# CONFIG_SYS_CLOCK_TICKS_PER_SEC in Zephyr's kernel/Kconfig if needed.

# ── Logging ────────────────────────────────────────────────────────────────────

config KNXIOT_LOG_LEVEL
    int "KNX-IoT stack log level"
    default 3
    range 0 3 if !KNXIOT_DEBUG
    range 0 4 if KNXIOT_DEBUG
    help
      Follows the Zephyr log level convention (CONFIG_<MODULE>_LOG_LEVEL).
      Corresponds to CMake: OC_PRINT_ENABLED (level > 0) / OC_DEBUG_ENABLED (level 4).
      0 = OFF   - no logging
      1 = ERR   - errors only
      2 = WRN   - warnings and errors
      3 = INF   - informational (default)
      4 = DBG   - debug (only available when KNXIOT_DEBUG=y)

config KNXIOT_DEBUG
    bool "Enable debug logging (level 4)"
    default n
    help
      Unlocks log level 4 (DBG) for KNXIOT_LOG_LEVEL.
      Corresponds to CMake: OC_DEBUG_ENABLED.

config KNXIOT_DEBUG_OSCORE
    bool "OSCORE debug output"
    default n
    depends on KNXIOT_DEBUG
    help
      Corresponds to CMake: OC_DEBUG_OSCORE_ENABLED.

config KNXIOT_LOG_HEXDUMP_DBG
    bool "Enable OC_LOGbytes() hex output"
    default n
    depends on KNXIOT_DEBUG
    help
      When enabled, OC_LOGbytes() and OC_LOGbytes_OSCORE() print byte buffers
      as lowercase hex ("xx xx ..."), 32 bytes per line. Buffers of 16 bytes
      or fewer fit on a single line.
      When disabled (default), OC_LOGbytes() is a no-op on Zephyr.

config KNXIOT_LOG_CAST_64_BIT_INTS
    bool "Cast 64-bit integers in log output"
    default n
    help
      Corresponds to CMake: KNX_LOG_CAST_64_BIT_INTS_ENABLED.

endif # KNXIOT_LIB
