{
  "version": 3,
  "configurePresets": [
    {
      "name": "common-config",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}"
    },
    {
      "name": "windows-common-config",
      "hidden": true,
      "inherits": "common-config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-common-config",
      "hidden": true,
      "inherits": "common-config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "debug-common-config",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OC_DEBUG_ENABLED": true,
        "OC_PRINT_ENABLED": true,
        "OC_DEBUG_OSCORE_ENABLED": true
      }
    },
    {
      "name": "release-common-config",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc-common-config",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "gcc-common-config",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "mingw64-common-config",
      "hidden": true,
      "toolchainFile": "${sourceDir}/cmake/toolchain-mingw64.cmake"
    },
    {
      "name": "windows-debug-msvc",
      "inherits": ["windows-common-config", "msvc-common-config", "debug-common-config"],
      "displayName": "Windows Debug (MSVC)",
      "description": "Target Windows with the Visual Studio (Code) development environment."
    },
    {
      "name": "windows-release-msvc",
      "inherits": ["windows-common-config", "msvc-common-config", "release-common-config"],
      "displayName": "Windows Release (MSVC)",
      "description": "Target Windows with the Visual Studio development environment."
    },
    {
      "name": "windows-debug-gcc",
      "inherits": ["windows-common-config", "gcc-common-config", "debug-common-config"],
      "displayName": "Windows Debug (GCC)",
      "description": "Build with MinGW-w64 GCC in Debug mode"
    },
    {
      "name": "windows-release-gcc",
      "inherits": ["windows-common-config", "gcc-common-config", "release-common-config"],
      "displayName": "Windows Release (GCC)",
      "description": "Build with MinGW-w64 GCC in Release mode"
    },
    {
      "name": "linux-debug-gcc",
      "inherits": ["linux-common-config", "gcc-common-config", "debug-common-config"],
      "displayName": "Linux Debug (GCC)",
      "description": "Target the Windows Subsystem for Linux (WSL) or a remote Linux system."
    },
    {
      "name": "linux-release-gcc",
      "inherits": ["linux-common-config", "gcc-common-config", "release-common-config"],
      "displayName": "Linux Release (GCC)",
      "description": "Target the Windows Subsystem for Linux (WSL) or a remote Linux system."
    },
    {
      "name": "windows-cross-debug",
      "inherits": ["common-config", "mingw64-common-config", "debug-common-config"],
      "displayName": "Windows Debug (Cross-compile MinGW)",
      "description": "Cross-compile Windows binaries using MinGW from Linux."
    },
    {
      "name": "windows-cross-release",
      "inherits": ["common-config", "mingw64-common-config", "release-common-config"],
      "displayName": "Windows Release (Cross-compile MinGW)",
      "description": "Cross-compile Windows binaries using MinGW from Linux."
    },
    {
      "name": "test-common-config",
      "hidden": true,
      "cacheVariables": {
        "BUILD_TESTING": true
      }
    },
    {
      "name": "windows-test-msvc",
      "inherits": ["windows-debug-msvc", "test-common-config"],
      "displayName": "Windows Test (MSVC)",
      "description": "Debug build with unit tests enabled (MSVC)."
    },
    {
      "name": "windows-test-gcc",
      "inherits": ["windows-debug-gcc", "test-common-config"],
      "displayName": "Windows Test (GCC)",
      "description": "Debug build with unit tests enabled (GCC)."
    },
    {
      "name": "windows-coverage-gcc",
      "inherits": "windows-test-gcc",
      "displayName": "Windows Coverage (MinGW GCC)",
      "description": "Debug build with unit tests and gcov source coverage (--coverage -O0). Report with: gcovr -r . --filter 'api/' --filter 'messaging/' --filter 'security/' --filter 'util/' --exclude 'api/c-timestamp/.*' <builddir> (MSYS2 gcov + pip gcovr)",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "ENABLE_COVERAGE": true
      }
    },
    {
      "name": "linux-test-gcc",
      "inherits": ["linux-debug-gcc", "test-common-config"],
      "displayName": "Linux Test (GCC)",
      "description": "Debug build with unit tests enabled (GCC)."
    },
    {
      "name": "linux-test-asan",
      "inherits": "linux-test-gcc",
      "displayName": "Linux Test + Sanitizers (GCC)",
      "description": "Debug build with ASan + UBSan enabled.",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "ENABLE_SANITIZERS": true
      }
    },
    {
      "name": "linux-coverage-gcc",
      "inherits": "linux-test-gcc",
      "displayName": "Linux Coverage (GCC)",
      "description": "Debug build with unit tests and gcov source coverage (--coverage -O0). Report with: gcovr -r . --filter 'api/' --filter 'messaging/' --filter 'security/' --filter 'util/' --exclude 'api/c-timestamp/.*' <builddir>",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "ENABLE_COVERAGE": true
      }
    },
    {
      "name": "linux-fuzz-clang",
      "inherits": "linux-common-config",
      "displayName": "Linux Fuzzers (clang + libFuzzer)",
      "description": "libFuzzer harnesses with ASan + UBSan. Logging is off: OC_PRINT dominates the runtime and throttles executions per second.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": true,
        "BUILD_FUZZERS": true,
        "OC_PRINT_ENABLED": false,
        "OC_DEBUG_ENABLED": false,
        "OC_DEBUG_OSCORE_ENABLED": false
      }
    },
    {
      "name": "linux-fuzz-coverage-clang",
      "inherits": "linux-fuzz-clang",
      "displayName": "Linux Fuzz Coverage (clang + libFuzzer)",
      "description": "Same as linux-fuzz-clang, plus gcov-compatible source coverage. Report with: gcovr -r . --gcov-executable 'llvm-cov gcov' --filter 'api/' --filter 'messaging/' --filter 'security/' --filter 'util/' --exclude 'api/c-timestamp/.*' <builddir>",
      "cacheVariables": {
        "ENABLE_COVERAGE": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-common-config",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-common-config",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-debug-msvc",
      "inherits": "windows-common-config",
      "displayName": "Windows Debug (MSVC)",
      "configurePreset": "windows-debug-msvc"
    },
    {
      "name": "windows-release-msvc",
      "inherits": "windows-common-config",
      "displayName": "Windows Release (MSVC)",
      "configurePreset": "windows-release-msvc"
    },
    {
      "name": "windows-debug-gcc",
      "inherits": "windows-common-config",
      "displayName": "Windows Debug (GCC)",
      "configurePreset": "windows-debug-gcc"
    },
    {
      "name": "windows-release-gcc",
      "inherits": "windows-common-config",
      "displayName": "Windows Release (GCC)",
      "configurePreset": "windows-release-gcc"
    },
    {
      "name": "linux-debug-gcc",
      "inherits": "linux-common-config",
      "displayName": "Linux Debug (GCC)",
      "configurePreset": "linux-debug-gcc"
    },
    {
      "name": "linux-release-gcc",
      "inherits": "linux-common-config",
      "displayName": "Linux Release (GCC)",
      "configurePreset": "linux-release-gcc"
    },
    {
      "name": "windows-cross-debug",
      "displayName": "Windows Debug (Cross-compile MinGW)",
      "configurePreset": "windows-cross-debug"
    },
    {
      "name": "windows-cross-release",
      "displayName": "Windows Release (Cross-compile MinGW)",
      "configurePreset": "windows-cross-release"
    },
    {
      "name": "windows-test-msvc",
      "inherits": "windows-common-config",
      "displayName": "Windows Test (MSVC)",
      "configurePreset": "windows-test-msvc"
    },
    {
      "name": "windows-test-gcc",
      "inherits": "windows-common-config",
      "displayName": "Windows Test (GCC)",
      "configurePreset": "windows-test-gcc"
    },
    {
      "name": "linux-test-gcc",
      "inherits": "linux-common-config",
      "displayName": "Linux Test (GCC)",
      "configurePreset": "linux-test-gcc"
    },
    {
      "name": "linux-test-asan",
      "inherits": "linux-common-config",
      "displayName": "Linux Test + Sanitizers (GCC)",
      "configurePreset": "linux-test-asan"
    },
    {
      "name": "linux-fuzz-clang",
      "inherits": "linux-common-config",
      "displayName": "Linux Fuzzers (clang + libFuzzer)",
      "configurePreset": "linux-fuzz-clang"
    },
    {
      "name": "linux-fuzz-coverage-clang",
      "inherits": "linux-common-config",
      "displayName": "Linux Fuzz Coverage (clang + libFuzzer)",
      "configurePreset": "linux-fuzz-coverage-clang"
    },
    {
      "name": "linux-coverage-gcc",
      "inherits": "linux-common-config",
      "displayName": "Linux Coverage (GCC)",
      "configurePreset": "linux-coverage-gcc"
    },
    {
      "name": "windows-coverage-gcc",
      "inherits": "windows-common-config",
      "displayName": "Windows Coverage (MinGW GCC)",
      "configurePreset": "windows-coverage-gcc"
    }
  ],
  "testPresets": [
    {
      "name": "windows-test-msvc",
      "configurePreset": "windows-test-msvc",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-test-gcc",
      "configurePreset": "windows-test-gcc",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-test-gcc",
      "configurePreset": "linux-test-gcc",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-test-asan",
      "configurePreset": "linux-test-asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-fuzz-clang",
      "configurePreset": "linux-fuzz-clang",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "fuzz" } }
    },
    {
      "name": "linux-fuzz-coverage-clang",
      "configurePreset": "linux-fuzz-coverage-clang",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "fuzz" } }
    },
    {
      "name": "linux-coverage-gcc",
      "configurePreset": "linux-coverage-gcc",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-coverage-gcc",
      "configurePreset": "windows-coverage-gcc",
      "output": { "outputOnFailure": true }
    }
  ]
}
